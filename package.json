{
  "name": "dsh-workbuddy-cny",
  "version": "0.1.0",
  "description": "Show WorkBuddy credits and DeepSeek CNY balance in one DSH sidebar line, with the credit→CNY conversion measured from real turns",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "codebuddy",
    "credits",
    "balance",
    "cny",
    "sidebar"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-slots"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1"
  }
}
